---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../lib/urlFor';
import { PortableText } from 'astro-portabletext';
import Block from '../../components/portabletext/Block.astro';

export async function getStaticPaths() {
  const articulos = await sanityClient.fetch(`*[_type == "articulo" && defined(slug.current)] { slug }`);
  return articulos.map((articulo: any) => ({ params: { slug: articulo.slug.current } }));
}

const { slug } = Astro.params;

const articulo = await sanityClient.fetch(`
  *[_type == "articulo" && slug.current == $slug][0] {
    title,
    "slug": slug.current,
    metaDescription,
    imagenDestacada,
    categoria,
    fechaPublicacion,
    contenido,
    productoRelacionado-> {
      title,
      "slug": slug.current,
      price,
      "mainImage": images[0].asset
    }
  }
`, { slug });

if (!articulo) {
  return Astro.redirect('/404');
}

const siteUrl = "https://www.xn--manolipastelesdepaales-1ec.com";
const fallbackImages: Record<string, { src: string; alt: string }> = {
  'tarta-de-panales-a-domicilio-badalona': { src: '/blog-tarta-panales-pedido-badalona.png', alt: 'Tarta de pañales artesanal preparada para recoger en Badalona' },
  'cestas-canastillas-bebes-diferencias': { src: '/blog-cestas-canastillas-bebe.png', alt: 'Canastilla de bebé con accesorios artesanales' },
  'panales-dodot-recien-nacidos-tarta': { src: '/blog-panales-recien-nacido.png', alt: 'Pañales para recién nacido junto a una tarta artesanal' },
  'regalos-originales-recien-nacidos': { src: '/blog-regalos-originales-bebe.png', alt: 'Ideas de regalos originales para un recién nacido' },
  'como-elegir-tarta-de-panales': { src: '/blog-tamanos-tarta-panales.png', alt: 'Tres tamaños de tartas de pañales artesanales' },
  'que-incluye-una-tarta-de-panales-artesanal-guia-2026': { src: '/blog-incluye-tarta-panales.png', alt: 'Accesorios que puede incluir una tarta de pañales artesanal' },
  'que-es-un-pastel-de-panales-y-por-que-es-el-regalo-perfecto': { src: '/blog-personalizar-tarta-panales.png', alt: 'Pastel de pañales personalizado con accesorios para bebé' }
};
const fallbackImage = fallbackImages[slug];
const imagenUrl = articulo.imagenDestacada
  ? urlFor(articulo.imagenDestacada).width(1200).format('webp').url()
  : `${siteUrl}${fallbackImage?.src || '/imagen-thumbnail2.png'}`;
const imagenAlt = articulo.imagenDestacada?.alt || fallbackImage?.alt || articulo.title;
const variants: Record<string, number> = {
  'tarta-de-panales-a-domicilio-badalona': 0,
  'cestas-canastillas-bebes-diferencias': 1,
  'panales-dodot-recien-nacidos-tarta': 2,
  'regalos-originales-recien-nacidos': 1,
  'como-elegir-tarta-de-panales': 0,
  'que-incluye-una-tarta-de-panales-artesanal-guia-2026': 2,
  'que-es-un-pastel-de-panales-y-por-que-es-el-regalo-perfecto': 1
};
const variant = variants[slug] ?? 0;

// Mapeo de categorías
const categorias: Record<string, string> = {
  'regalos-bebes': 'Regalos para Bebés',
  'guias-consejos': 'Guías y Consejos',
  'hospitales-maternidad': 'Hospitales y Maternidad',
  'sobre-manoli': 'Sobre Manoli'
};

const seoOverrides: Record<string, { title: string; description: string }> = {
  'tarta-de-panales-a-domicilio-badalona': {
    title: 'Tarta de pañales en Badalona: cómo encargarla',
    description: 'Cómo encargar una tarta de pañales en Badalona, qué plazo necesitas y cómo coordinar la recogida por WhatsApp.'
  },
  'cestas-canastillas-bebes-diferencias': {
    title: 'Cestas y canastillas para bebé: diferencias y elección',
    description: 'Diferencias entre una cesta, una canastilla y una tarta de pañales para elegir un regalo útil y bonito para un recién nacido.'
  },
  'panales-dodot-recien-nacidos-tarta': {
    title: 'Pañales para recién nacido en una tarta artesanal',
    description: 'Qué talla y tipo de pañal conviene usar en una tarta para recién nacido y cómo elegir un regalo práctico.'
  },
  'regalos-originales-recien-nacidos': {
    title: 'Regalos originales para recién nacidos: ideas útiles',
    description: 'Ideas de regalos originales para recién nacidos, con opciones artesanales, útiles y fáciles de personalizar.'
  },
  'como-elegir-tarta-de-panales': {
    title: 'Cómo elegir una tarta de pañales: tamaño y personalización',
    description: 'Guía para elegir una tarta de pañales por tamaño, contenido, presupuesto y personalización.'
  },
  'que-incluye-una-tarta-de-panales-artesanal-guia-2026': {
    title: 'Qué incluye una tarta de pañales artesanal',
    description: 'Qué puede incluir una tarta de pañales artesanal, cómo se presenta y qué conviene confirmar antes de encargarla.'
  },
  'que-es-un-pastel-de-panales-y-por-que-es-el-regalo-perfecto': {
    title: 'Qué es un pastel de pañales y por qué regalarlo',
    description: 'Qué es un pastel de pañales, qué utilidad tiene y por qué es un regalo especial para un nacimiento.'
  }
};
const seo = seoOverrides[slug] || { title: articulo.title, description: articulo.metaDescription };

// Formatear fecha
function formatDate(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Schema Article para SEO
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${siteUrl}/blog/${slug}#article`,
  "headline": articulo.title,
  "description": seo.description,
  "image": imagenUrl,
  "datePublished": articulo.fechaPublicacion,
  "dateModified": articulo.fechaPublicacion,
  "author": {
    "@type": "Person",
    "name": "Manoli",
    "url": `${siteUrl}/sobre-nosotros`
  },
  "publisher": {
    "@type": "LocalBusiness",
    "name": "Manoli Pasteles de Pañales",
    "@id": `${siteUrl}/#business`,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/blog/${slug}`
  },
  "articleSection": categorias[articulo.categoria] || articulo.categoria,
  "inLanguage": "es"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${siteUrl}/blog/${slug}/#breadcrumbs`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog/` },
    { "@type": "ListItem", "position": 3, "name": articulo.title, "item": `${siteUrl}/blog/${slug}/` }
  ]
};

---

<Layout title={`${seo.title} | Manoli Pasteles`} description={seo.description} image={imagenUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={[
    { name: "Blog", url: "/blog" },
    { name: articulo.title }
  ]} />

  <main class="bg-white min-h-screen">
    <!-- Header del artículo -->
    <article class={`blog-article blog-article--variant-${variant} max-w-6xl mx-auto px-4 py-10 md:py-14`}>
      <header class="article-hero mb-12">
        <div class="article-hero__copy">
          <div class="flex flex-wrap items-center gap-3 mb-5">
          <span class="text-sm font-bold text-pink-600 bg-pink-100 px-3 py-1 rounded-full">
            {categorias[articulo.categoria] || articulo.categoria}
          </span>
          <span class="text-sm text-gray-500">
            {formatDate(articulo.fechaPublicacion)}
          </span>
          <span class="text-sm text-gray-500">· 5 min de lectura</span>
          </div>

        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 leading-tight mb-6">
          {articulo.title}
        </h1>

        <p class="article-lead text-xl text-gray-600 leading-relaxed">
          {seo.description}
        </p>
        </div>

        <figure class="article-hero__image rounded-3xl overflow-hidden shadow-xl bg-pink-50">
          <img src={imagenUrl} alt={imagenAlt} width="1200" height="800" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption class="sr-only">{imagenAlt}</figcaption>
        </figure>
      </header>

      <div class="article-layout">
        <aside class="article-index h-fit rounded-3xl bg-gray-50 border border-gray-100 p-6" aria-label="Información del artículo">
          <p class="text-xs font-bold uppercase tracking-wide text-pink-600 mb-3">Guía de Manoli</p>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">Consejos claros para elegir un regalo de bebé artesanal y coordinarlo en Badalona.</p>
          <a href="/productos/" class="block rounded-full bg-pink-600 px-5 py-3 text-center font-bold text-white hover:bg-pink-700">Ver catálogo</a>
        </aside>

        <div class="articulo-contenido">
          <PortableText value={articulo.contenido} components={{ block: Block }} />
        </div>
      </div>

      <div class="mt-12 rounded-2xl border border-pink-100 bg-pink-50 p-7">
        <h2 class="text-2xl font-bold text-gray-800 mb-3">¿Buscas un regalo para bebé en Badalona?</h2>
        <p class="text-gray-700 leading-relaxed mb-5">Manoli prepara pasteles de pañales artesanales por encargo. Consulta los modelos, el plazo y la personalización; la recogida se coordina por WhatsApp.</p>
        <div class="flex flex-wrap gap-3">
          <a href="/productos/" class="rounded-full bg-pink-600 px-5 py-3 font-bold text-white hover:bg-pink-700">Ver catálogo</a>
          <a href="/pasteles-panales-badalona/" class="rounded-full border border-pink-200 bg-white px-5 py-3 font-bold text-pink-700 hover:bg-pink-100">Servicio en Badalona</a>
        </div>
      </div>

      <style>
        .article-hero {
          display: grid;
          gap: 2.5rem;
          align-items: center;
        }
        .article-hero__image {
          min-height: 18rem;
          aspect-ratio: 3 / 2;
        }
        .article-hero__image img {
          min-height: 100%;
        }
        .article-layout {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          gap: 2.5rem;
          align-items: start;
        }
        .article-index {
          order: 2;
        }
        .articulo-contenido {
          max-width: 48rem;
        }
        .articulo-contenido h2 {
          scroll-margin-top: 6rem;
        }
        .blog-article--variant-1 .article-hero {
          max-width: 52rem;
          margin: 0 auto;
          text-align: center;
        }
        .blog-article--variant-1 .article-hero__copy {
          max-width: 48rem;
          margin: 0 auto;
        }
        .blog-article--variant-1 .article-hero__image {
          width: 100%;
        }
        .blog-article--variant-2 .article-hero {
          padding: 2rem;
          border-radius: 2rem;
          background: linear-gradient(135deg, #fdf2f8, #fff7ed);
        }
        .blog-article--variant-2 .article-hero__image {
          order: -1;
        }
        @media (min-width: 768px) {
          .article-hero {
            grid-template-columns: minmax(0, 1fr) minmax(20rem, .9fr);
          }
          .blog-article--variant-1 .article-hero {
            display: block;
          }
          .blog-article--variant-1 .article-hero__image {
            margin-top: 2.5rem;
            max-height: 30rem;
          }
          .blog-article--variant-2 .article-hero {
            grid-template-columns: minmax(20rem, .85fr) minmax(0, 1fr);
          }
          .blog-article--variant-2 .article-hero__image {
            order: 0;
          }
          .article-layout {
            grid-template-columns: minmax(0, 1fr) 17rem;
          }
          .article-index {
            order: 0;
            position: sticky;
            top: 2rem;
          }
        }
        .articulo-contenido h2 {
          font-size: 1.5rem;
          font-weight: 700;
          color: #1f2937;
          margin-top: 2.5rem;
          margin-bottom: 1rem;
        }
        .articulo-contenido h3 {
          font-size: 1.25rem;
          font-weight: 700;
          color: #1f2937;
          margin-top: 2rem;
          margin-bottom: 0.75rem;
        }
        .articulo-contenido p {
          color: #374151;
          line-height: 1.75;
          margin-bottom: 1rem;
        }
        .articulo-contenido strong {
          color: #1f2937;
          font-weight: 600;
        }
        .articulo-contenido a {
          color: #db2777;
          text-decoration: underline;
        }
        .articulo-contenido ul, .articulo-contenido ol {
          margin: 1rem 0;
          padding-left: 1.5rem;
        }
        .articulo-contenido li {
          color: #374151;
          margin-bottom: 0.5rem;
        }
        .articulo-contenido blockquote {
          border-left: 4px solid #f9a8d4;
          padding-left: 1rem;
          font-style: italic;
          color: #4b5563;
          margin: 1.5rem 0;
        }
      </style>

      <!-- Autor -->
      <div class="mt-12 pt-8 border-t border-gray-100">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center">
            <span class="text-2xl">👩‍🍳</span>
          </div>
          <div>
            <p class="font-bold text-gray-800">Manoli</p>
            <p class="text-gray-600 text-sm">Artesana de pasteles de pañales en Badalona</p>
          </div>
        </div>
      </div>

      <!-- Producto relacionado -->
      {articulo.productoRelacionado && (
        <div class="mt-12 bg-pink-50 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-gray-800 mb-6">Producto relacionado</h3>
          <a href={`/productos/${articulo.productoRelacionado.slug}`} class="flex flex-col sm:flex-row gap-6 group">
            {articulo.productoRelacionado.mainImage && (
              <div class="w-full sm:w-48 aspect-square rounded-xl overflow-hidden bg-white shadow-sm">
                <img
                  src={urlFor(articulo.productoRelacionado.mainImage).width(400).format('webp').url()}
                  alt={articulo.productoRelacionado.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
            )}
            <div class="flex-1">
              <h4 class="text-lg font-bold text-gray-800 group-hover:text-pink-600 transition-colors">
                {articulo.productoRelacionado.title}
              </h4>
              <p class="text-pink-600 font-bold mt-2">{articulo.productoRelacionado.price}</p>
              <span class="inline-block mt-4 text-pink-600 font-medium">Ver producto →</span>
            </div>
          </a>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-12 text-center bg-gray-50 rounded-2xl p-8">
        <h3 class="text-xl font-bold text-gray-800 mb-4">¿Te ha gustado este artículo?</h3>
        <p class="text-gray-600 mb-6">Explora nuestro catálogo de regalos artesanales para bebés.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/productos" class="bg-pink-600 text-white px-6 py-3 rounded-full font-bold hover:bg-pink-700 transition">
            Ver Catálogo
          </a>
          <a href="/contacto" class="bg-white text-pink-600 border-2 border-pink-200 px-6 py-3 rounded-full font-bold hover:border-pink-400 transition">
            Contactar
          </a>
        </div>
      </div>
    </article>

    <!-- Más artículos -->
    <section class="bg-gray-50 py-16 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl font-bold text-gray-800 mb-8">Sigue leyendo</h2>
        <a href="/blog" class="text-pink-600 font-medium hover:underline">
          ← Volver al blog
        </a>
      </div>
    </section>
  </main>
</Layout>
