---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "Recogida de pasteles de pañales en Badalona | Manoli";
const description = "Ya no ofrecemos entregas en hospitales. Encarga tu pastel de pañales por WhatsApp y recoge tu pedido en Badalona con cita previa.";
---

<Layout title={title} description={description} noindex={true}>
  <Breadcrumbs items={[{ name: "Recogida en Badalona" }]} />
  <main class="bg-pink-50 min-h-screen py-16 px-4">
    <section class="max-w-3xl mx-auto bg-white rounded-3xl shadow-sm p-8 md:p-12 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-800 mb-6">Recogida de pasteles de pañales en Badalona</h1>
      <p class="text-lg text-gray-700 leading-relaxed mb-4">Esta página informaba de un servicio antiguo. Actualmente Manoli prepara los pasteles por encargo y los entrega mediante <strong>recogida concertada en casa, en Badalona</strong>.</p>
      <p class="text-lg text-gray-700 leading-relaxed mb-8">Consulta los modelos disponibles, el plazo y la personalización por WhatsApp.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/productos/" class="inline-flex rounded-full bg-pink-600 px-6 py-3 font-bold text-white hover:bg-pink-700">Ver catálogo</a>
        <a href="/preguntas-frecuentes/" class="inline-flex rounded-full border border-pink-200 px-6 py-3 font-bold text-pink-700 hover:bg-pink-50">Preguntas frecuentes</a>
      </div>
    </section>
  </main>
</Layout>
