---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../lib/urlFor';

// Traemos productos destacados
const products = await sanityClient.fetch(`
  *[_type == "producto" || _type == "product"] | order(_createdAt desc)[0..3] {
    title,
    price,
    "slug": slug.current,
    "mainImage": images[0].asset
  }
`);

// SEO Local optimizado para Badalona
const title = "Pasteles de Pañales en Badalona | Recogida por WhatsApp - Manoli";
const description = "Pasteles de pañales artesanales en Badalona. Encarga por WhatsApp y recoge tu regalo con cita previa. Opciones personalizadas y económicas.";

const siteUrl = "https://www.xn--manolipastelesdepaales-1ec.com";

// Schema LocalBusiness específico para Badalona
const localSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}/pasteles-panales-badalona#local`,
  "name": "Manoli Pasteles de Pañales - Badalona",
  "description": "Taller artesanal de pasteles de pañales y regalos para bebé en Badalona. Pedidos por WhatsApp y recogida concertada en casa.",
  "image": `${siteUrl}/imagen-thumbnail2.png`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Badalona",
    "addressLocality": "Badalona",
    "addressRegion": "Barcelona",
    "postalCode": "08911",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 41.4469,
    "longitude": 2.2450
  },
  "url": `${siteUrl}/pasteles-panales-badalona`,
  "telephone": "+34678846424",
  "priceRange": "€€",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "10:00",
      "closes": "20:00"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Badalona" },
    { "@type": "Place", "name": "Centre Badalona" },
    { "@type": "Place", "name": "Gorg" },
    { "@type": "Place", "name": "Llefià" },
    { "@type": "Place", "name": "Sant Roc" },
    { "@type": "Place", "name": "La Salut" },
    { "@type": "Place", "name": "Artigues" },
    { "@type": "Place", "name": "Montigalà" }
  ],
  "sameAs": ["https://www.instagram.com/grageramanoli"]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(localSchema)} />

  <Breadcrumbs items={[{ name: "Pasteles de Pañales en Badalona" }]} />

  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-pink-100 to-pink-50 py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-pink-600 text-white text-sm font-bold px-4 py-1 rounded-full mb-6">
          Badalona y alrededores
        </span>

        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-800 mb-6 leading-tight">
          Pasteles de Pañales en <span class="text-pink-600">Badalona</span>
        </h1>

        <p class="text-xl text-gray-600 mb-8 leading-relaxed max-w-2xl mx-auto">
          Creamos <strong>tartas de pañales artesanales</strong> con todo el cariño.
          Encarga por WhatsApp y recoge tu pedido <strong>en casa, en Badalona</strong>, con cita previa.
          Recogida directa, sin mensajería y sin riesgo de que se desmonte.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/productos" class="bg-pink-600 text-white px-8 py-4 rounded-full font-bold hover:bg-pink-700 transition shadow-lg">
            Ver Catálogo
          </a>
          <a href="https://wa.me/34678846424?text=Hola%20Manoli%2C%20quiero%20encargar%20un%20pastel%20de%20pa%C3%B1ales%20en%20Badalona" target="_blank" rel="noopener noreferrer" class="bg-white text-pink-600 border-2 border-pink-200 px-8 py-4 rounded-full font-bold hover:border-pink-400 transition">
            Pedir por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Por qué elegirnos -->
    <section class="py-16 px-4 bg-white">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-800 text-center mb-12">
          ¿Por qué elegir Manoli en Badalona?
        </h2>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">🏠</span>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">Recogida concertada</h3>
            <p class="text-gray-600">
              Te lo llevo personalmente a tu casa, trabajo o donde me digas.
              Así el pastel llega <strong>perfecto y sin desmontar</strong>.
            </p>
          </div>

          <div class="text-center p-6">
            <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">👶</span>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">Pañales Dodot</h3>
            <p class="text-gray-600">
              Solo uso <strong>pañales de primera marca</strong> (Dodot Sensitive).
              Calidad garantizada para la piel del bebé.
            </p>
          </div>

          <div class="text-center p-6">
            <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">🎨</span>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">100% Personalizado</h3>
            <p class="text-gray-600">
              Elige colores, temática y accesorios.
              Puedes <strong>traerme tus propios regalos</strong> para incluirlos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Área local y recogida -->
    <section class="py-16 px-4 bg-pink-50">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-800 text-center mb-8">
          Recogida fácil en Badalona y alrededores
        </h2>
        <p class="text-center text-gray-600 mb-10">
          Te confirmamos por WhatsApp el horario de recogida en casa. Atendemos pedidos de Badalona y personas de los alrededores que puedan desplazarse.
        </p>

        <div class="flex flex-wrap justify-center gap-3">
          {["Centre", "Gorg", "Llefià", "Sant Roc", "La Salut", "Artigues", "Montigalà", "Pomar", "Bufalà", "Canyet", "Sant Crist"].map(barrio => (
            <span class="bg-white px-4 py-2 rounded-full text-gray-700 font-medium shadow-sm border border-pink-100">
              {barrio}
            </span>
          ))}
        </div>

        <p class="text-center text-gray-500 mt-8 text-sm">
          También atendemos encargos de <strong>Sant Adrià de Besòs</strong>, <strong>Santa Coloma de Gramenet</strong> y <strong>Barcelona ciudad</strong> si puedes desplazarte a Badalona.
        </p>
      </div>
    </section>

    <!-- Productos destacados -->
    <section class="py-16 px-4 bg-white">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-800 text-center mb-4">
          Algunos de nuestros trabajos
        </h2>
        <p class="text-center text-gray-600 mb-10">
          Cada pastel es único, hecho a mano con mimo para cada familia.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {products.map((product: any) => (
            <a href={`/productos/${product.slug}`} class="group">
              <article class="bg-white rounded-xl shadow-sm hover:shadow-md transition border border-gray-100 overflow-hidden">
                <div class="aspect-square overflow-hidden bg-gray-100">
                  {product.mainImage ? (
                    <img
                      src={urlFor(product.mainImage).width(400).format('webp').url()}
                      alt={`${product.title} - Pastel de pañales Badalona`}
                      class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex items-center justify-center h-full text-gray-400">Sin imagen</div>
                  )}
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-gray-800 group-hover:text-pink-600 transition">{product.title}</h3>
                  <p class="text-pink-600 font-bold mt-1">{product.price} €</p>
                </div>
              </article>
            </a>
          ))}
        </div>

        <div class="text-center mt-10">
          <a href="/productos" class="inline-block bg-pink-600 text-white px-8 py-3 rounded-full font-bold hover:bg-pink-700 transition">
            Ver todo el catálogo
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Final -->
    <section class="py-20 px-4 bg-gradient-to-r from-pink-500 to-pink-600 text-white">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          ¿Buscas el regalo perfecto para un nacimiento en Badalona?
        </h2>
        <p class="text-xl opacity-90 mb-8">
          Escríbeme por WhatsApp y te ayudo a crear algo especial. Sin compromiso.
        </p>
        <a href="https://wa.me/34678846424?text=Hola%20Manoli%2C%20quiero%20informaci%C3%B3n%20sobre%20pasteles%20de%20pa%C3%B1ales%20en%20Badalona" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white text-pink-600 px-8 py-4 rounded-full font-bold hover:bg-gray-100 transition shadow-lg">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.008-.57-.008-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Contactar por WhatsApp
        </a>
      </div>
    </section>
  </main>
</Layout>
