---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Regalos de nacimiento y pasteles de pañales artesanales en Badalona. Hechos a mano con amor y productos de primeras marcas.",
  image = "/og-default.jpg",
  noindex = false
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://www.xn--manolipastelesdepaales-1ec.com';
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Se configura en el hosting como PUBLIC_GA_MEASUREMENT_ID.
// No cargamos Analytics si el valor sigue siendo un marcador o no existe.
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const hasValidAnalyticsId = typeof GA_MEASUREMENT_ID === 'string' && /^G-[A-Z0-9]+$/i.test(GA_MEASUREMENT_ID);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="canonical" href={canonicalURL} />

    {hasValidAnalyticsId && <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
      <script define:vars={{ GA_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', GA_MEASUREMENT_ID);
      </script>
    </>}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Manoli Pasteles de Pañales" />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="google-site-verification" content="acky7Mc_SQ-I_no5U-D4CUCTC3kKwHwe5KOX9vjrDTE" />
    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <slot />
    <Footer />
    {hasValidAnalyticsId && <script is:inline>
      const pagePath = window.location.pathname;
      const pageType = pagePath.startsWith('/productos/') && pagePath !== '/productos/' ? 'product' : pagePath.startsWith('/productos') ? 'catalog' : 'content';
      if (typeof window.gtag === 'function') {
        window.gtag('event', pageType === 'product' ? 'product_view' : pageType === 'catalog' ? 'catalog_view' : 'content_view', {
          page_type: pageType,
          page_location: window.location.href
        });
      }
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('a') : null;
        if (!target || typeof window.gtag !== 'function') return;
        const href = target.getAttribute('href') || '';
        if (href.includes('wa.me') || href.includes('api.whatsapp.com')) {
          window.gtag('event', 'whatsapp_click', { link_url: href, page_location: window.location.href, page_type: pageType });
        } else if (href.startsWith('tel:')) {
          window.gtag('event', 'phone_click', { link_url: href, page_location: window.location.href, page_type: pageType });
        } else if (href === '/productos' || href === '/productos/') {
          window.gtag('event', 'catalog_click', { link_url: href, page_location: window.location.href, page_type: pageType });
        } else if (href.startsWith('/productos/')) {
          window.gtag('event', 'product_click', { link_url: href, page_location: window.location.href, page_type: pageType });
        }
      });
    </script>}
  </body>
</html>
